{
  "mcpServers": {
    "llmos": {
      "command": "bun",
      "args": ["--no-install", "--no-env-file", "--config=/dev/null", "./dist/mcp.js"],
      "cwd": ".",
      "env_vars": [
        "LLMOS_ROOT",
        "INDEX_PATH",
        "QMD_CONFIG_DIR",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_STATE_HOME"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 300,
      "default_tools_approval_mode": "prompt",
      "tools": {
        "read": { "approval_mode": "approve" },
        "neighbors": { "approval_mode": "approve" },
        "subgraph": { "approval_mode": "approve" },
        "check": { "approval_mode": "approve" },
        "health": { "approval_mode": "approve" },
        "search": { "approval_mode": "approve" },
        "setup": { "approval_mode": "approve" },
        "daily_append_thought": { "approval_mode": "prompt" },
        "file_inbox": { "approval_mode": "prompt" },
        "set_property": { "approval_mode": "prompt" }
      }
    }
  }
}

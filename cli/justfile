# Task runner for the llmOS tools (run from cli/; `bun install --frozen-lockfile` first).

_default:
    @just --list

# Regenerate the marketplace catalogs at the repository root.
gen:
    bun scripts/gen-marketplaces.ts

# Fail when a catalog differs from a fresh generation.
drift: gen
    git diff --exit-code ../.claude-plugin/marketplace.json ../.agents/plugins/marketplace.json

types:
    bun run typecheck

lint:
    bun run lint

# Unit tests, hook tests, and the contract snapshot tests (test/contract/).
test:
    bun test

# Record the contract snapshots again from the TypeScript output, after an
# intended contract change; review the diff before committing it.
contract-record:
    bun test/contract/record.ts

# Check the frontmatter invariants on a vault. For the real vault, pass a copy
# made outside it; write any report to ../artifacts/.
invariants +vaults:
    bun test/contract/invariants.ts {{vaults}}

# Fail unless `bun` is the version in .tool-versions, which CI also reads: a
# bundle built by another Bun version differs from CI's build.
bun-version:
    @test "$(bun --version)" = "$(sed -n 's/^bun //p' .tool-versions)" || { echo "bun $(bun --version) is not the pinned $(sed -n 's/^bun //p' .tool-versions) in cli/.tool-versions; run mise install from cli/" >&2; exit 1; }

# Rebuild the committed plugin bundles: the hooks that run on every tool call
# (../dist/pre-tool-use.js, from src/hooks/pre-tool-use.ts), the other hooks
# (../dist/hooks.js, from src/hooks/main.ts), and the MCP launcher
# (../dist/mcp.js, from src/mcp-launcher.ts).
hooks: bun-version
    bun run build:hooks
    bun run build:mcp

# Fail when a committed bundle differs from a fresh build.
hooks-drift: hooks
    git diff --exit-code ../dist/hooks.js ../dist/pre-tool-use.js ../dist/mcp.js

# Drive the real CLI, MCP server, and hooks on a scratch fixture vault.
# Evidence goes to ../artifacts/verify-llmos/; feature names limit the run.
verify-llmos *features:
    @bun ../.agents/skills/verify-llmos/scripts/verify.ts run {{features}}

# Model-check with TLA+ that the digest keeps text written to a daily note
# during its model call (the verify-daily-digest skill).
verify-daily-digest:
    @bun ../.agents/skills/verify-daily-digest/scripts/check.ts

# Run every model check: each ../.agents/skills/verify-* skill with a .tla
# file runs its scripts/check.ts. CI runs this in its own job.
verify-models:
    @bun scripts/verify-models.ts

# Model-check with TLA+ that the shared-memory Git sync never reverts remote
# or local work or pushes a private note, and its lock (the verify-memory-sync
# skill).
verify-memory-sync:
    @bun ../.agents/skills/verify-memory-sync/scripts/check.ts

# Model-check with TLA+ that concurrent service starts, stops, and crashes
# leave one reachable service (the verify-llmos-service skill).
verify-llmos-service:
    @bun ../.agents/skills/verify-llmos-service/scripts/check.ts

# The only writer of the plugin version. The owner picks the level. It sets
# the four version fields and dates the CHANGELOG `## Unreleased` notes.
release level:
    bun scripts/release.ts bump {{level}}

# Fail when the version fields or the CHANGELOG disagree (scripts/release.ts).
release-check:
    bun scripts/release.ts check

check: drift types lint test hooks-drift release-check

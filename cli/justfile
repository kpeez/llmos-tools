# Task runner for the llmOS tools (run from tools/cli/; `bun install --frozen-lockfile` first).

_default:
    @just --list

# Regenerate the marketplace catalogs at the repository root.
gen:
    bun scripts/gen-marketplaces.ts

# Fail when a catalog differs from a fresh generation.
drift: gen
    git diff --exit-code ../../.claude-plugin/marketplace.json ../../.agents/plugins/marketplace.json

types:
    bun run typecheck

lint:
    bun run lint

# Unit tests, hook tests, and the contract snapshot tests (test/contract/).
test:
    bun test

# Record the contract snapshots again from the TypeScript output, after an
# intended contract change; review the diff before committing it.
contract-record:
    bun test/contract/record.ts

# Check the frontmatter invariants on a vault. For the real vault, copy it
# outside llmOS/ first and pass the copy; write any report to ../../artifacts/.
invariants +vaults:
    bun test/contract/invariants.ts {{vaults}}

# Fail unless `bun` is the version in .tool-versions, which CI also reads: a
# bundle built by another Bun version differs from CI's build.
bun-version:
    @test "$(bun --version)" = "$(sed -n 's/^bun //p' .tool-versions)" || { echo "bun $(bun --version) is not the pinned $(sed -n 's/^bun //p' .tool-versions) in tools/cli/.tool-versions; run mise install from tools/cli/" >&2; exit 1; }

# Rebuild the committed plugin bundles: the hooks (../dist/hooks.js, from
# src/hooks/) and the MCP launcher (../dist/mcp.js, from src/mcp-launcher.ts).
hooks: bun-version
    bun run build:hooks
    bun run build:mcp

# Fail when a committed bundle differs from a fresh build.
hooks-drift: hooks
    git diff --exit-code ../dist/hooks.js ../dist/mcp.js

# Drive the real CLI, MCP server, and hooks on a scratch fixture vault.
# Evidence goes to ../../artifacts/verify-llmos/; feature names limit the run.
verify-llmos *features:
    @bun ../../.agents/skills/verify-llmos/scripts/verify.ts run {{features}}

# Model-check with TLA+ that the digest keeps text written to a daily note
# during its model call (the verify-daily-digest skill).
verify-daily-digest:
    @bun ../../.agents/skills/verify-daily-digest/scripts/check.ts

check: drift types lint test hooks-drift

// A hook reaches its harness only through emit() in cli/src/hooks/main.ts, which
// picks the envelope for each event. Hook and MCP code takes its scope from the
// session roots, never from the process folder, which a harness may set to the
// plugin folder. biome.json scopes this plugin to src/hooks/**, src/mcp.ts, and
// src/memory.ts, and leaves main.ts out.
language js

or {
  JsStaticMemberExpression() as $stdout where {
    $stdout <: r"process\.stdout",
    register_diagnostic(
      span=$stdout,
      message="Emit through main.ts: a hook writes its output only through emit() in cli/src/hooks/main.ts, which picks the channel and envelope the harness reads.",
      severity="error"
    )
  },
  JsStaticMemberExpression() as $bunout where {
    $bunout <: r"Bun\.stdout",
    register_diagnostic(
      span=$bunout,
      message="Emit through main.ts: a hook writes its output only through emit() in cli/src/hooks/main.ts, which picks the channel and envelope the harness reads.",
      severity="error"
    )
  },
  JsCallExpression() as $log where {
    $log <: r"console\.[A-Za-z]+\([\s\S]*",
    register_diagnostic(
      span=$log,
      message="Emit through main.ts: a console method writes to stdout or stderr, which a harness may drop or reject. Use emit() in cli/src/hooks/main.ts.",
      severity="error"
    )
  },
  JsVariableDeclarator() as $pull where {
    $pull <: r"^\{[^}]*\b(?:stdout|cwd)\b[^}]*\}\s*=\s*(?:process|Bun)\b[\s\S]*",
    register_diagnostic(
      span=$pull,
      message="Emit through main.ts, and take scope from session roots, not process.cwd(): do not pull stdout or cwd out of process or Bun. Use emit() in cli/src/hooks/main.ts, and the payload cwd.",
      severity="error"
    )
  },
  JsImport() as $pulled where {
    $pulled <: r"[\s\S]*\b(?:stdout|cwd)\b[\s\S]*",
    $pulled <: r"[\s\S]*from\s+[\"'](?:node:)?process[\"'][\s\S]*",
    register_diagnostic(
      span=$pulled,
      message="Emit through main.ts, and take scope from session roots, not process.cwd(): do not import stdout or cwd from process. Use emit() in cli/src/hooks/main.ts, and the payload cwd.",
      severity="error"
    )
  },
  JsCallExpression() as $cwd where {
    $cwd <: r"process\.cwd\(\)",
    register_diagnostic(
      span=$cwd,
      message="Take scope from session roots, not process.cwd(): the harness may start the process in the plugin folder. Use the payload cwd or the project root.",
      severity="error"
    )
  }
}

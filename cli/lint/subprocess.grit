// Only cli/src/run.ts starts a subprocess (biome.json scopes this plugin to
// the code outside it). A spawn elsewhere has no required time limit, and a
// child that hangs hangs its caller: the Stop reindex, the doctor, and the
// digest's model call each hung once. The plugin catches the member forms
// (`Bun.spawn`, `globalThis.Bun.spawnSync`, `Bun.$`), a destructuring of
// them from `Bun`, and every way to load `node:child_process` or to import
// `spawn`, `spawnSync`, or `$` from `bun`. It does not catch a computed name
// such as `Bun["spawn"]`.
language js

or {
  JsStaticMemberExpression() as $call where {
    $call <: r"^(?:globalThis\s*\.\s*)?Bun\s*\.\s*(?:spawn|spawnSync|\$)$",
    register_diagnostic(
      span=$call,
      message="Start subprocesses only through run(), start(), or startDetached() in cli/src/run.ts: its options make timeoutMs required, so no child runs without a time limit.",
      severity="error"
    )
  },
  JsVariableDeclarator() as $pick where {
    $pick <: r"^\{[^}]*(?:\bspawn\b|\bspawnSync\b|\$)[^}]*\}\s*=\s*(?:globalThis\s*\.\s*)?Bun$",
    register_diagnostic(
      span=$pick,
      message="Start subprocesses only through run(), start(), or startDetached() in cli/src/run.ts: its options make timeoutMs required, so no child runs without a time limit.",
      severity="error"
    )
  },
  JsImport() as $import where {
    $import <: or {
      r"[\s\S]*[\"'](?:node:)?child_process[\"'][\s\S]*",
      r"[\s\S]*\{[^}]*(?:\bspawn\b|\bspawnSync\b|\$)[^}]*\}\s*from\s*[\"']bun[\"'][\s\S]*"
    },
    register_diagnostic(
      span=$import,
      message="Start subprocesses only through run(), start(), or startDetached() in cli/src/run.ts: its options make timeoutMs required, so no child runs without a time limit.",
      severity="error"
    )
  },
  JsExport() as $export where {
    $export <: r"[\s\S]*from\s*[\"'](?:node:)?child_process[\"'][\s\S]*",
    register_diagnostic(
      span=$export,
      message="Start subprocesses only through run(), start(), or startDetached() in cli/src/run.ts: its options make timeoutMs required, so no child runs without a time limit.",
      severity="error"
    )
  },
  JsImportCallExpression() as $load where {
    $load <: r"^import\s*\(\s*[\"'](?:node:)?child_process[\"']\s*\)$",
    register_diagnostic(
      span=$load,
      message="Start subprocesses only through run(), start(), or startDetached() in cli/src/run.ts: its options make timeoutMs required, so no child runs without a time limit.",
      severity="error"
    )
  },
  JsCallExpression() as $require where {
    $require <: r"^require\s*\(\s*[\"'](?:node:)?child_process[\"']\s*\)$",
    register_diagnostic(
      span=$require,
      message="Start subprocesses only through run(), start(), or startDetached() in cli/src/run.ts: its options make timeoutMs required, so no child runs without a time limit.",
      severity="error"
    )
  }
}

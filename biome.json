{
  "$schema": "./cli/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "cli/src/**",
      "cli/test/**",
      "!cli/test/contract/snapshots",
      "!cli/test/fixtures/web",
      "cli/bin/**",
      "cli/scripts/**/*.ts",
      "*.json",
      "cli/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "plugins": [
    {
      "path": "./cli/lint/git-spawn.grit",
      "includes": ["**/cli/src/**", "**/cli/bin/**", "**/cli/scripts/**", "!**/cli/src/git.ts"]
    },
    "./cli/lint/git-words.grit",
    {
      "path": "./cli/lint/hook-channels.grit",
      "includes": [
        "**/cli/src/hooks/**",
        "**/cli/src/mcp.ts",
        "**/cli/src/memory.ts",
        "!**/cli/src/hooks/main.ts"
      ]
    },
    {
      "path": "./cli/lint/vault-reads.grit",
      "includes": [
        "**/cli/src/vault.ts",
        "**/cli/src/write.ts",
        "**/cli/src/memory.ts",
        "**/cli/src/schema.ts",
        "**/cli/src/digest.ts",
        "**/cli/src/daily.ts",
        "**/cli/src/authoring.ts",
        "**/cli/src/health.ts",
        "**/cli/src/mcp.ts",
        "**/cli/src/commands.ts",
        "**/cli/src/hooks/context.ts"
      ]
    }
  ],
  "overrides": [
    {
      "includes": [
        "**/cli/src/vault.ts",
        "**/cli/src/write.ts",
        "**/cli/src/memory.ts",
        "**/cli/src/schema.ts",
        "**/cli/src/digest.ts",
        "**/cli/src/daily.ts",
        "**/cli/src/authoring.ts",
        "**/cli/src/health.ts",
        "**/cli/src/mcp.ts",
        "**/cli/src/commands.ts",
        "**/cli/src/hooks/context.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": {
                    "importNames": ["readFileSync", "readFile", "promises", "default", "*"],
                    "message": "Read a vault note with readText(resolveInVault(root, relative)) from cli/src/vault-file.ts. A raw fs read follows symbolic links and '..' out of the vault (see the memory-index escape, fc6f60a)."
                  },
                  "fs": {
                    "importNames": ["readFileSync", "readFile", "promises", "default", "*"],
                    "message": "Read a vault note with readText(resolveInVault(root, relative)) from cli/src/vault-file.ts. A raw fs read follows symbolic links and '..' out of the vault (see the memory-index escape, fc6f60a)."
                  },
                  "node:fs/promises": {
                    "message": "Read a vault note with readText(resolveInVault(root, relative)) from cli/src/vault-file.ts. A raw fs read follows symbolic links and '..' out of the vault (see the memory-index escape, fc6f60a)."
                  },
                  "fs/promises": {
                    "message": "Read a vault note with readText(resolveInVault(root, relative)) from cli/src/vault-file.ts. A raw fs read follows symbolic links and '..' out of the vault (see the memory-index escape, fc6f60a)."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

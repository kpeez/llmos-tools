{
  "$schema": "./cli/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "cli/src/**",
      "cli/test/**",
      "!cli/test/contract/snapshots",
      "!cli/test/fixtures/web",
      "cli/bin/**",
      "cli/scripts/**/*.ts",
      "*.json",
      "cli/*.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "plugins": [
    {
      "path": "./cli/lint/git-spawn.grit",
      "includes": ["**/cli/src/**", "**/cli/bin/**", "**/cli/scripts/**", "!**/cli/src/git.ts"]
    },
    "./cli/lint/git-words.grit",
    {
      "path": "./cli/lint/subprocess.grit",
      "includes": ["**/cli/src/**", "**/cli/bin/**", "**/cli/scripts/**", "!**/cli/src/run.ts"]
    }
  ]
}

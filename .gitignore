# Python caches of the Hermes adapter (hermes/), and build output of the
# retired Python package, which older checkouts may still hold.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ty_cache/
*.egg-info/
build/
# Only the committed hook and MCP launcher bundles belong in dist/.
dist/*
!dist/hooks.js
!dist/mcp.js
.DS_Store
artifacts
node_modules/
# The link to the project documents in the vault (see AGENTS.md).
/.agents/docs

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file --config=/dev/null \"$CLAUDE_PLUGIN_ROOT\"/dist/hooks.js session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Grep|Glob|LS|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file --config=/dev/null \"$CLAUDE_PLUGIN_ROOT\"/dist/hooks.js pre-tool-use",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__(?:plugin_llmos_)?llmos__(?:daily_append_thought|file_inbox|set_property)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file --config=/dev/null \"$CLAUDE_PLUGIN_ROOT\"/dist/hooks.js pre-tool-use",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file --config=/dev/null \"$CLAUDE_PLUGIN_ROOT\"/dist/hooks.js guard-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file --config=/dev/null \"$CLAUDE_PLUGIN_ROOT\"/dist/hooks.js post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file --config=/dev/null \"$CLAUDE_PLUGIN_ROOT\"/dist/hooks.js stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
